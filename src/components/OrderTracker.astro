---
interface Props {
  /** URL del Apps Script que guarda la consulta en la pestaña "Pedidos". */
  endpoint: string;
}

const { endpoint } = Astro.props;
---

<div hidden data-order-tracker data-endpoint={endpoint}></div>

<script>
  // Freno corto contra dobles clics. Sin memoria entre visitas: cada pedido real cuenta, y el
  // abuso lo limita el Apps Script (envíos por minuto) y el aviso (una consulta por producto y día).
  const DEBOUNCE_MS = 10_000;
  const lastSent = new Map<string, number>();

  const tracker = document.querySelector<HTMLElement>('[data-order-tracker]');
  const endpoint = tracker?.dataset['endpoint'] ?? '';

  if (endpoint !== '') {
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLElement>('[data-order-product]');
      const product = link?.dataset['orderProduct'];
      if (!product) return;
      const now = Date.now();
      const previous = lastSent.get(product);
      if (previous !== undefined && now - previous < DEBOUNCE_MS) return;
      lastSent.set(product, now);
      // Sin esperar respuesta: `keepalive` termina el envío aunque se abra WhatsApp.
      // Solo viaja el nombre del producto: nada de datos personales.
      fetch(endpoint, {
        method: 'POST',
        mode: 'no-cors',
        keepalive: true,
        body: new URLSearchParams({ product }),
      }).catch(() => {});
    });
  }
</script>
