---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { formatCop } from '@/lib/order';

interface Props {
  name: string;
  description: string;
  includes: readonly string[];
  price?: number | undefined;
  image: ImageMetadata;
  imageAlt: string;
  /** Enlace de pedido por WhatsApp; `null` si el negocio aún no configuró su número. */
  orderHref: string | null;
  /** Nivel del título según la sección: 2 en el inicio, 3 bajo una categoría. */
  headingLevel: 2 | 3;
  /** Solo la primera tarjeta visible al cargar debe cargar su imagen con prioridad. */
  priority?: boolean;
}

const {
  name,
  description,
  includes,
  price,
  image,
  imageAlt,
  orderHref,
  headingLevel,
  priority = false,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<article class="product-card">
  <Image
    src={image}
    alt={imageAlt}
    widths={[320, 640]}
    sizes="(min-width: 60rem) 20rem, (min-width: 40rem) 45vw, 85vw"
    loading={priority ? 'eager' : 'lazy'}
    {...(priority ? { fetchpriority: 'high' } : {})}
  />
  <div class="product-card__body">
    <Heading class="product-card__name">{name}</Heading>
    <p>{description}</p>
    {includes.length > 0 && (
      <ul class="product-card__includes" aria-label={`Incluye (${name})`}>
        {includes.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
    <p class="product-card__price">
      {price === undefined ? 'Precio a consultar' : formatCop(price)}
    </p>
    {orderHref ? (
      <a
        class="button button--whatsapp product-card__order"
        href={orderHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Pedir por WhatsApp
        <span class="visually-hidden">{`: ${name} (se abre en una pestaña nueva)`}</span>
      </a>
    ) : (
      <p class="product-card__pending">Pedidos por WhatsApp disponibles muy pronto.</p>
    )}
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .product-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
  }

  .product-card__body p {
    margin: 0;
  }

  .product-card__name {
    margin: 0;
    font-size: 1.25rem;
  }

  .product-card__includes {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .product-card__price {
    margin-top: auto !important;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .product-card__order {
    align-self: flex-start;
  }

  .product-card__pending {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
