---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Carousel from '@/components/Carousel.astro';
import ProductCard from '@/components/ProductCard.astro';
import { displayName, siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { orderHref } from '@/lib/catalog';
import { buildInquiryMessage } from '@/lib/order';
import { visibleItems } from '@/lib/publishing';
import { withBase } from '@/lib/url';
import { buildWaMeUrl, normalizePhone } from '@/lib/whatsapp';

const products = visibleItems(
  (await getCollection('productos')).map((entry) => ({ id: entry.id, ...entry.data })),
  false,
);
const featured = products.filter((product) => product.featured);
// Imagen del hero: el primer destacado o, si no hay, el primer producto del catálogo.
const heroProduct = featured[0] ?? products[0];
const whatsApp =
  siteConfig.whatsApp && normalizePhone(siteConfig.whatsApp) ? siteConfig.whatsApp : null;
const inquiryHref = whatsApp ? buildWaMeUrl(whatsApp, buildInquiryMessage(displayName)) : null;

// Franja de confianza: solo datos reales del catálogo y de la configuración.
const trustPoints = [
  ...(products.length > 0
    ? [
        {
          value: String(products.length),
          label: products.length === 1 ? 'desayuno en el catálogo' : 'desayunos en el catálogo',
        },
      ]
    : []),
  ...(siteConfig.city ? [{ value: 'Entregas', label: `en ${siteConfig.city}` }] : []),
  ...(whatsApp ? [{ value: 'Pedidos', label: 'por WhatsApp, con el mensaje listo' }] : []),
];

// Solo datos visibles en la página.
const jsonLd = siteConfig.businessName
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: siteConfig.businessName,
      ...(siteConfig.description ? { description: siteConfig.description } : {}),
      ...(Astro.site ? { url: Astro.site.href } : {}),
      ...(whatsApp ? { telephone: whatsApp } : {}),
      ...(siteConfig.city ? { areaServed: siteConfig.city } : {}),
      ...(siteConfig.instagramUrl ? { sameAs: [siteConfig.instagramUrl] } : {}),
    }
  : undefined;
---

<BaseLayout
  title={displayName}
  description={siteConfig.description ?? `Desayunos sorpresa de ${displayName}.`}
  {...(jsonLd ? { jsonLd } : {})}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        {siteConfig.city && <p class="eyebrow">{siteConfig.city}</p>}
        <h1>{displayName}</h1>
        {siteConfig.tagline && <p class="lead">{siteConfig.tagline}</p>}
        <p class="hero__actions">
          <a class="button" href={withBase('catalogo/')}>
            Ver catálogo
          </a>
          {inquiryHref && (
            <a
              class="button button--whatsapp"
              href={inquiryHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Escríbenos por WhatsApp
              <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
            </a>
          )}
        </p>
      </div>
      {heroProduct && (
        <Image
          class="hero__image"
          src={heroProduct.image}
          alt={heroProduct.imageAlt}
          widths={[480, 800, 1000]}
          sizes="(min-width: 60rem) 34rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  {trustPoints.length > 0 && (
    <section class="trust" aria-label={`Cómo trabaja ${displayName}`}>
      <ul class="container trust__list">
        {trustPoints.map((point) => (
          <li>
            <strong>{point.value}</strong>
            <span>{point.label}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {featured.length > 0 && (
    <section class="section container" aria-labelledby="destacados">
      <div class="section-heading">
        <h2 id="destacados">Desayunos destacados</h2>
        <a href={withBase('catalogo/')}>Ver todo el catálogo</a>
      </div>
      <Carousel label="Desayunos destacados">
        {featured.map((product) => (
          <li>
            <ProductCard
              name={product.name}
              description={product.description}
              includes={product.includes}
              price={product.price}
              image={product.image}
              imageAlt={product.imageAlt}
              orderHref={orderHref(whatsApp, product.name, product.price)}
              headingLevel={3}
            />
          </li>
        ))}
      </Carousel>
    </section>
  )}

  <section class="section container" aria-labelledby="como-pedir">
    <h2 id="como-pedir">Cómo pedir</h2>
    <ol class="steps">
      <li>
        Elige tu desayuno en el <a href={withBase('catalogo/')}>catálogo</a>.
      </li>
      <li>Pulsa "Pedir por WhatsApp" y envía el mensaje que se prepara solo.</li>
      <li>
        Acordamos contigo la fecha, la dirección y el pago. Revisa las{' '}
        <a href={withBase('entregas/')}>zonas y horarios de entrega</a>.
      </li>
    </ol>
    <p>
      ¿Tienes dudas? Mira las <a href={withBase('preguntas/')}>preguntas frecuentes</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-surface), var(--color-tint));
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-4);
  }

  .hero__image {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.12);
  }

  .eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-accent-text);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .trust {
    background: var(--color-strip-bg);
    color: var(--color-strip-text);
  }

  .trust__list {
    display: grid;
    gap: var(--space-2);
    margin-block: 0;
    padding-block: var(--space-3);
    list-style: none;
  }

  .trust__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .trust__list strong {
    color: var(--color-accent-on-primary);
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1;
  }

  .trust__list span {
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-4);
    }

    .trust__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
  }

  .steps {
    max-width: 40rem;
    padding-left: 1.25rem;
  }
</style>
