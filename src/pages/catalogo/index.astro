---
import { getCollection } from 'astro:content';
import ProductCard from '@/components/ProductCard.astro';
import { displayName, siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { orderHref } from '@/lib/catalog';
import { groupByCategory } from '@/lib/order';
import { visibleItems } from '@/lib/publishing';
import { slugify } from '@/lib/content-sync/text';

const products = visibleItems(
  (await getCollection('productos')).map((entry) => ({ id: entry.id, ...entry.data })),
  false,
);
const groups = groupByCategory(products);
---

<BaseLayout
  title="Catálogo"
  description={`Catálogo de desayunos sorpresa de ${displayName}: fotos, precios y pedido por WhatsApp.`}
>
  <section class="section container">
    <h1>Catálogo</h1>
    <p class="lead">Elige tu desayuno y haz el pedido por WhatsApp.</p>
    {groups.length === 0 ? (
      <p class="notice">Muy pronto publicaremos nuestro catálogo.</p>
    ) : (
      <>
        {groups.length > 1 && (
          <nav aria-label="Categorías" class="categories">
            <ul>
              {groups.map((group) => (
                <li>
                  <a href={`#${slugify(group.category)}`}>{group.category}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {groups.map((group, groupIndex) => (
          <section class="category" aria-labelledby={slugify(group.category)}>
            <h2 id={slugify(group.category)}>{group.category}</h2>
            <ul class="products">
              {group.items.map((product, index) => (
                <li>
                  <ProductCard
                    name={product.name}
                    description={product.description}
                    includes={product.includes}
                    price={product.price}
                    image={product.image}
                    imageAlt={product.imageAlt}
                    orderHref={orderHref(siteConfig.whatsApp, product.name, product.price)}
                    headingLevel={3}
                    priority={groupIndex === 0 && index === 0}
                  />
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )}
  </section>
</BaseLayout>

<style>
  .categories ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
  }

  .category + .category {
    margin-top: var(--space-4);
  }

  .products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
