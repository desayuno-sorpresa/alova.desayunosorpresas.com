---
import { getCollection } from 'astro:content';
import OrderTracker from '@/components/OrderTracker.astro';
import RecentOrdersToast from '@/components/RecentOrdersToast.astro';
import SeoHead from '@/components/SeoHead.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import { displayName, siteConfig } from '@/config/site';
import { LIMITS } from '@/lib/content-sync/limits';
import { buildInquiryMessage } from '@/lib/order';
import { buildWaMeUrl, normalizePhone } from '@/lib/whatsapp';
import '@/styles/global.css';
import '@/styles/theme.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const whatsApp = siteConfig.whatsApp
  ? { label: siteConfig.whatsApp, href: buildWaMeUrl(siteConfig.whatsApp) }
  : null;
const headerCta =
  siteConfig.whatsApp && normalizePhone(siteConfig.whatsApp)
    ? {
        label: 'Pedir por WhatsApp',
        href: buildWaMeUrl(siteConfig.whatsApp, buildInquiryMessage(displayName)),
      }
    : undefined;
const orders = (await getCollection('pedidos')).map((entry) => entry.data);
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      noindex={noindex}
      {...(jsonLd ? { jsonLd } : {})}
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <SiteHeader
      siteName={displayName}
      nav={siteConfig.nav}
      {...(siteConfig.announcement ? { announcement: siteConfig.announcement } : {})}
      {...(headerCta ? { cta: headerCta } : {})}
    />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    {siteConfig.orderTracking.endpoint && (
      <OrderTracker endpoint={siteConfig.orderTracking.endpoint} />
    )}
    <RecentOrdersToast
      orders={orders}
      maxDays={LIMITS.order.days}
      liveEndpoint={siteConfig.orderTracking.endpoint ?? undefined}
    />
    {headerCta && <WhatsAppFloat href={headerCta.href} />}
    <SiteFooter
      siteName={displayName}
      city={siteConfig.city}
      whatsApp={whatsApp}
      instagramUrl={siteConfig.instagramUrl}
      directory={siteConfig.directory}
    />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: -10rem;
    z-index: 10;
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface);
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: var(--space-1);
  }

  main:focus {
    outline: none;
  }
</style>
